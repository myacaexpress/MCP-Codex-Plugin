# Copy to your host's secret/env settings. This file contains NO secrets: the server only
# verifies tokens with the identity provider's PUBLIC keys. Never put tokens in URLs.

# Public HTTPS URL of the MCP endpoint (exactly what teammates paste into ChatGPT). Also the token audience.
MEDCARE_RESOURCE_URL=https://medcare-mcp.example.com/mcp
# Identity provider issuer, exactly as in its metadata (Auth0 keeps the trailing slash).
MEDCARE_OAUTH_ISSUER=https://your-tenant.us.auth0.com/
# Optional overrides (normally discovered from the issuer metadata)
# MEDCARE_OAUTH_JWKS_URL=https://your-tenant.us.auth0.com/.well-known/jwks.json
# MEDCARE_OAUTH_USERINFO_URL=https://your-tenant.us.auth0.com/userinfo
# MEDCARE_OAUTH_AUDIENCE=https://medcare-mcp.example.com/mcp

# Team allowlist: individual accounts only (comma separated). Server refuses to start if both are empty.
MEDCARE_ALLOWED_EMAILS=agent1@yourcompany.example,agent2@yourcompany.example
# MEDCARE_ALLOWED_SUBJECTS=auth0|abc123
MEDCARE_REQUIRED_SCOPES=medcare:read
# Claims checked for the user's email (custom namespaced claim from an IdP action, then standard 'email');
# if absent, the IdP's userinfo endpoint is asked (MEDCARE_USERINFO_FALLBACK=1). An email counts only when the
# matching *_verified claim (or userinfo email_verified) is literally true; userinfo must return the same 'sub'.
MEDCARE_EMAIL_CLAIMS=https://medcare-resources/email,email

# Limits
MEDCARE_MAX_BODY_BYTES=262144
MEDCARE_MAX_CONCURRENT_CALLS=4
MEDCARE_QUEUE_TIMEOUT_SECONDS=20
MEDCARE_CALL_TIMEOUT_SECONDS=300
MEDCARE_RATE_LIMIT_PER_MINUTE=30
MEDCARE_RATE_LIMIT_BURST=15
MEDCARE_MAX_CONNECTIONS=64
# Browser Origins accepted if an Origin header is present ('*' disables the check)
MEDCARE_ALLOWED_ORIGINS=https://chatgpt.com,https://chat.openai.com

# Runtime
PORT=8080
MEDCARE_CACHE_DIR=/data/cache
MEDCARE_CMS_MAX_AGE_DAYS=7
MEDCARE_LOG_TRACEBACKS=0
# Trust X-Forwarded-* only from your platform's proxy
FORWARDED_ALLOW_IPS=*

MEDCARE_REMOTE_BATCH_BUDGET_SECONDS=90
